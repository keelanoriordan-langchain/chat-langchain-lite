# Copy this file to .env and fill in your values

# Model access is routed through the LangSmith Gateway, whose URL is a
# hardcoded constant in utils/models.py. No direct-provider key or base URL
# is needed — and if your shell injects them, ./start.sh clears them first,
# since a stray ANTHROPIC_CUSTOM_HEADERS gets merged into every gateway
# request by the anthropic SDK.

# LangSmith
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=chat-langchain-lite
LANGSMITH_WORKSPACE_ID=your-demo-workspace-id
LANGSMITH_API_KEY_GATEWAY=your-demo-gateway-key

DEMO_PRESENTER="robert"

# FastHTML frontend (optional)
# Base URL the frontend uses to reach the co-located graph over the LangGraph
# SDK. Must be loopback. Defaults to the `langgraph dev` port; set to
# http://localhost:8000 in a deployment (the container's API port).
# LANGGRAPH_API_URL=http://localhost:2024

# Signs the session cookie holding the chat thread id. Use any stable random
# string — without it the key is regenerated every restart, invalidating open
# tabs so the UI answers "Invalid run" instead of streaming.
# SESSION_SECRET=change-me-in-production
